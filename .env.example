# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Engine (Gemini 1.5 Flash / Gemini 3.8 Flash via @google/genai)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Payment Processor (Lemon Squeezy Sandbox Test Mode)
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_test_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret

# External Data Pipeline Identifiers (SEC EDGAR requires User-Agent header)
SEC_EDGAR_USER_AGENT=VerifynIntelligenceAdmin research@verifyn.io

# Contact Form & Lead Generation Integration (Resend or Formspree)
# Resend API Key for corporate inquiry lead dispatch.
# DEV FALLBACK: If configured with dummy keys (e.g., re_dummy_resend_key_12345) or if network fails,
# the server catches the error, logs the lead payload to console, and returns HTTP 200 Success UI state.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
CONTACT_NOTIFICATION_EMAIL=leads@verifyn.io
FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# Anti-Abuse Rate Limiting (Upstash Redis)
# Distributed sliding-window rate limiting (3 searches per 30 days per network IP).
# DEV FALLBACK: If configured with dummy credentials (e.g. https://dummy-redis.upstash.io, dummy_upstash_token_12345)
# or if Upstash connection fails, the middleware logs a warning and allows the request through instead of throwing a 500 error.
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Application URL
APP_URL="MY_APP_URL"
